# ================= Epic 账号 =================
# 两步验证支持「验证器 App」和「邮箱验证码」两种（详见 README 第四节）；
# 短信验证码不支持——若账号只开了短信 2FA，请改用前两种或先关闭。
EPIC_EMAIL=
EPIC_PASSWORD=

# 如果账号开了「验证器 App」两步验证，把二维码对应的 Base32 密钥填这里
# 注意：填密钥本体，不是那 6 位动态码。没开就留空。
EPIC_TOTP_SECRET=

# ── 邮箱 2FA 取码（账号用「邮箱验证码」而不是验证器 App 时填这里）──
# 原理：脚本连 IMAP 读最新一封 Epic 邮件，自动抽出 6 位验证码填进登录页。
# 重要：Epic 账号邮箱若在 Gmail，必须先设置「自动转发」到下面这个国内邮箱——
#       本机网络访问 Gmail / Google 完全不通（实测超时），只能读国内邮箱。
# 注意：EPIC_IMAP_PASS 填邮箱的「IMAP/SMTP 授权码」，不是邮箱登录密码。
#       163 开启路径：设置 → POP3/SMTP/IMAP → 开启「IMAP/SMTP服务」→ 新增授权密码。
# 端口必须用 143：实测容器出口把 993 封了（163/126/QQ 的 993 全部超时），143 正常。
EPIC_IMAP_HOST=imap.163.com
EPIC_IMAP_PORT=143
EPIC_IMAP_USER=
EPIC_IMAP_PASS=
EPIC_IMAP_FOLDER=INBOX
# 只认发件人里含此字样的邮件，避免误取别的验证码
EPIC_OTP_SENDER_HINT=epicgames
# 等验证码邮件最多等多久（秒）
EPIC_OTP_WAIT_SECONDS=180
# 只接受此时长内收到的邮件（秒），避免误用旧验证码
EPIC_OTP_LOOKBACK_SECONDS=600

# 多账号（可选）：每行一个「邮箱:密码」。填了它会覆盖上面的单账号配置。
# EPIC_ACCOUNTS=


# ================= 视觉大模型（用来自动过 hCaptcha）=================
# 目前推荐智谱 GLM：国内直连、有免费额度、glm-4.6v 识图够用。
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6v

# 下面 4 个模型覆盖项【必须留空】，留空时会自动跟随 GLM_MODEL。
# 千万别填 gemini-* 的模型名，否则 GLM 路线会调用失败。
CHALLENGE_CLASSIFIER_MODEL=
IMAGE_CLASSIFIER_MODEL=
SPATIAL_POINT_REASONER_MODEL=
SPATIAL_PATH_REASONER_MODEL=


# ================= 运行参数（一般不用改）=================
# true = 开容器内定时任务（周四23:30 ~ 周五03:30 每小时 + 每天12:00）
ENABLE_APSCHEDULER=true
# 浏览器后端：auto / camoufox / playwright
# 本项目镜像里已装好 Camoufox 内核，保持 auto 即可。
BROWSER_BACKEND=auto
HEADLESS=virtual

# 网络质量差或风控严重时可挂代理。只对浏览器生效，IMAP/GLM 不走代理。
# 容器内访问宿主机代理写法：http://host.docker.internal:<端口>
BROWSER_PROXY=

# 本机网络慢就调大这两个值（秒）
EXECUTION_TIMEOUT=120
RESPONSE_TIMEOUT=30

# 本地补丁：登录页元素等待超时（毫秒）。上游硬编码 10 秒，国内网络建议放宽。
EPIC_ELEMENT_TIMEOUT_MS=60000

RETRY_ON_FAILURE=false
WAIT_FOR_CHALLENGE_VIEW_TO_RENDER_MS=1500
CONSTRAINT_RESPONSE_SCHEMA=true


# ================= 内置通知（我们改用邮件，这里保持留空）=================
# 两个都填才会启用 Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
