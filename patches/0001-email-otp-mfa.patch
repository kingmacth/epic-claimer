@@ -0,0 +1,159 @@
+# -*- coding: utf-8 -*-
+"""邮箱取码自测脚本。
+
+在真正跑登录流程之前，先用它单独验证三件事：
+  1) 能不能连上邮箱的 IMAP；
+  2) 收件箱里到底有没有 Epic 的验证码邮件（即 Gmail 自动转发是否生效）；
+  3) 验证码能不能被正确抽出来。
+
+用法（在 epic-claimer 目录下执行）：
+
+    docker compose run --rm --no-deps claimer \
+        /app/.venv/bin/python /app/tools/test_email_otp.py
+
+只想看最近邮件、不做取码：
+
+    docker compose run --rm --no-deps claimer \
+        /app/.venv/bin/python /app/tools/test_email_otp.py --list 15
+"""
+from __future__ import annotations
+
+import argparse
+import email
+import email.utils
+import sys
+import time
+from contextlib import suppress
+
+sys.path.insert(0, "/app/app")
+sys.path.insert(0, "/app")
+
+from services.epic_email_otp_service import (  # noqa: E402
+    _connect,
+    _decode_header_value,
+    _env,
+    _env_int,
+    _find_code,
+    _message_text,
+    email_otp_enabled,
+)
+
+
+def _mask(value: str) -> str:
+    if not value:
+        return "(空)"
+    if "@" in value:
+        name, _, domain = value.partition("@")
+        return f"{name[:2]}***@{domain}"
+    return f"长度{len(value)}"
+
+
+def print_config() -> bool:
+    print("=" * 62)
+    print("邮箱取码配置")
+    print("=" * 62)
+    host = _env("EPIC_IMAP_HOST", "imap.163.com")
+    port = _env_int("EPIC_IMAP_PORT", 143)
+    user = _env("EPIC_IMAP_USER")
+    password = _env("EPIC_IMAP_PASS")
+    print(f"  EPIC_IMAP_HOST          = {host}")
+    print(f"  EPIC_IMAP_PORT          = {port}")
+    print(f"  EPIC_IMAP_USER          = {_mask(user)}")
+    print(f"  EPIC_IMAP_PASS          = {_mask(password)}")
+    print(f"  EPIC_IMAP_FOLDER        = {_env('EPIC_IMAP_FOLDER', 'INBOX')}")
+    print(f"  EPIC_OTP_SENDER_HINT    = {_env('EPIC_OTP_SENDER_HINT', 'epicgames')}")
+    print(f"  EPIC_OTP_WAIT_SECONDS   = {_env_int('EPIC_OTP_WAIT_SECONDS', 180)}")
+    print(f"  EPIC_OTP_LOOKBACK_SECONDS = {_env_int('EPIC_OTP_LOOKBACK_SECONDS', 600)}")
+
+    if not email_otp_enabled():
+        print("\n[结果] 未配置 IMAP 账号/授权码，无法测试。请填写 .env 里的")
+        print("       EPIC_IMAP_USER 和 EPIC_IMAP_PASS 后重试。")
+        return False
+    return True
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--list", type=int, default=12, help="列出最近 N 封邮件")
+    args = parser.parse_args()
+
+    if not print_config():
+        return 2
+
+    print("\n" + "=" * 62)
+    print("连接 IMAP")
+    print("=" * 62)
+    started = time.time()
+    try:
+        conn = _connect()
+    except Exception as err:  # noqa: BLE001
+        print(f"[失败] 连接/登录失败：{type(err).__name__}: {err}")
+        print("       常见原因：授权码填错（要用「授权码」不是登录密码）、")
+        print("       或邮箱未开启 IMAP 服务。")
+        return 3
+    print(f"[成功] 已登录，耗时 {time.time() - started:.1f}s")
+
+    folder = _env("EPIC_IMAP_FOLDER", "INBOX")
+    hint = _env("EPIC_OTP_SENDER_HINT", "epicgames").lower()
+
+    try:
+        typ, data = conn.select(folder, readonly=True)
+        print(f"[{'成功' if typ == 'OK' else '失败'}] 打开文件夹 {folder}: {typ}")
+        since = time.strftime("%d-%b-%Y", time.gmtime(time.time() - 30 * 86400))
+        typ, data = conn.uid("SEARCH", None, f"(SINCE {since})")
+        uids = data[0].split() if (typ == "OK" and data and data[0]) else []
+        print(f"[信息] 近 30 天共 {len(uids)} 封邮件，将检查最近 {args.list} 封")
+
+        epic_hits: list[tuple[float, str, str, str | None]] = []
+        print("\n" + "=" * 62)
+        print("最近邮件")
+        print("=" * 62)
+        for uid in reversed(uids[-args.list :]):
+            typ, fetched = conn.uid("FETCH", uid, "(RFC822)")
+            if typ != "OK" or not fetched:
+                continue
+            raw = next(
+                (i[1] for i in fetched if isinstance(i, tuple) and len(i) > 1), None
+            )
+            if not raw:
+                continue
+            msg = email.message_from_bytes(raw)
+            sender = _decode_header_value(msg.get("From"))
+            subject = _decode_header_value(msg.get("Subject"))
+            received = time.time()
+            with suppress(Exception):
+                received = email.utils.parsedate_to_datetime(msg.get("Date")).timestamp()
+            stamp = time.strftime("%m-%d %H:%M", time.localtime(received))
+            is_epic = hint in sender.lower()
