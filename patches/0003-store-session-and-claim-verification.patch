diff --git a/tools/claim_receipts.py b/tools/claim_receipts.py
new file mode 100644
index 0000000..451a20f
--- /dev/null
+++ b/tools/claim_receipts.py
@@ -0,0 +1,177 @@
+# -*- coding: utf-8 -*-
+"""读取 Epic 领取回执邮件，列出最近实际入库的游戏。
+
+用途：Epic 的"页面 UI 标记"判定会误报（结算 iframe 未收尾时会显示 IN LIBRARY，
+但实际没有订单）。**回执邮件是"确实入库"的权威凭证**，因此用它做最终核对与通知。
+
+在容器内运行：
+    docker exec epic-freebies-helper uv run tools/claim_receipts.py --hours 72
+"""
+from __future__ import annotations
+
+import argparse
+import email
+import imaplib
+import os
+import re
+import ssl
+import sys
+from datetime import datetime, timedelta, timezone
+from email.header import decode_header, make_header
+from email.utils import parsedate_to_datetime
+
+IMAP_SEND_ID = '("name" "epic-claimer" "version" "1.0" "vendor" "workbuddy")'
+LABELS = {
+    "description:",
+    "publisher:",
+    "price:",
+    "discounts:",
+    "sale discount",
+    "quantity:",
+    "item:",
+}
+PRICE_RE = re.compile(r"^-?\s*\$[\d.,]+\s*(usd|us\$)?$", re.I)
+
+
+def dec(value) -> str:
+    if not value:
+        return ""
+    try:
+        return str(make_header(decode_header(value)))
+    except Exception:
+        return str(value)
+
+
+def html_to_lines(html: str) -> list[str]:
+    html = re.sub(r"<(script|style)[^>]*>.*?</\1>", " ", html, flags=re.S | re.I)
+    html = re.sub(r"<br\s*/?>|</(p|div|tr|td|h\d)>", "\n", html, flags=re.I)
+    html = re.sub(r"<[^>]+>", " ", html)
+    html = (
+        html.replace("&nbsp;", " ")
+        .replace("&amp;", "&")
+        .replace("&#39;", "'")
+        .replace("&quot;", '"')
+    )
+    return [ln.strip() for ln in html.splitlines() if ln.strip()]
+
+
+def extract_titles(msg: email.message.Message) -> list[str]:
+    body_lines: list[str] = []
+    for part in msg.walk():
+        if part.get_content_type() != "text/html":
+            continue
+        payload = part.get_payload(decode=True)
+        if not payload:
+            continue
+        lines = html_to_lines(payload.decode(part.get_content_charset() or "utf-8", errors="replace"))
+        if len(lines) > len(body_lines):
+            body_lines = lines
+
+    if not body_lines:
+        return []
+
+    try:
+        start = next(
+            i for i, ln in enumerate(body_lines) if "WHAT YOU ORDERED" in ln.upper()
+        )
+    except StopIteration:
+        return []
+
+    titles: list[str] = []
+    seen_label = False
+    for ln in body_lines[start + 1 : start + 40]:
+        upper = ln.upper()
+        if upper.startswith("TOTAL") or "KEEP A COPY" in upper:
+            break
+        if ln.lower() in LABELS:
+            seen_label = True
+            continue
+        if PRICE_RE.match(ln) or ln.lower().startswith(("order id", "invoice")):
+            continue
+        # 表格被压平后顺序是：Description/Publisher/Price 表头 → 标题 → 发行商 → 价格
+        if seen_label:
+            titles.append(ln)
+            break
+    return titles
+
+
+def connect():
+    host = os.environ.get("EPIC_IMAP_HOST", "imap.163.com")
+    port = int(os.environ.get("EPIC_IMAP_PORT", "143") or 143)
+    user = os.environ.get("EPIC_IMAP_USER", "")
+    pwd = os.environ.get("EPIC_IMAP_PASS", "")
+    folder = os.environ.get("EPIC_IMAP_FOLDER", "INBOX") or "INBOX"
+    if not user or not pwd:
+        raise SystemExit("[error] 未配置 EPIC_IMAP_USER / EPIC_IMAP_PASS")
+
+    if port == 993:
+        conn = imaplib.IMAP4_SSL(host, port, timeout=40)
+    else:
+        conn = imaplib.IMAP4(host, port, timeout=40)
+        conn.starttls(ssl_context=ssl.create_default_context())
+
+    conn.login(user, pwd)
+    # 163 要求登录后立刻发 ID，否则 SELECT 返回 "EXAMINE Unsafe Login"
+    if not hasattr(imaplib, "Commands"):
+        imaplib.Commands = {}
+    if "ID" not in imaplib.Commands:
+        imaplib.Commands["ID"] = ("AUTH", "SELECTED")
+    try:
+        typ, dat = conn._simple_command("ID", IMAP_SEND_ID)
+        conn._untagged_response(typ, dat, "ID")
+    except Exception:
+        pass
+
+    conn.select(folder, readonly=True)
+    return conn
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--hours", type=int, default=72, help="只看最近多少小时的回执")
+    args = ap.parse_args()
+
+    since = datetime.now(timezone.utc) - timedelta(hours=args.hours)
+    conn = connect()
+
+    typ, data = conn.uid("SEARCH", None, "SINCE", since.strftime("%d-%b-%Y"))
+    uids = data[0].split() if typ == "OK" and data and data[0] else []
+
+    rows: list[tuple[str, str, str]] = []
+    for uid in uids:
+        typ, fetched = conn.uid("FETCH", uid, "(RFC822)")
+        raw = next((it[1] for it in fetched if isinstance(it, tuple) and len(it) > 1), b"")
+        if not raw:
+            continue
+        msg = email.message_from_bytes(raw)
+        subject = dec(msg.get("Subject"))
+        if "receipt" not in subject.lower():
+            continue
+        try:
+            dt = parsedate_to_datetime(msg.get("Date"))
+            if dt.tzinfo is None:
+                dt = dt.replace(tzinfo=timezone.utc)
+        except Exception:
+            dt = since
+        if dt < since:
+            continue
+        local = dt.astimezone().strftime("%Y-%m-%d %H:%M")
+        titles = extract_titles(msg)
+        body = " / ".join(titles) if titles else "(未能解析，请人工查看)"
+        rows.append((local, body, subject))
+
+    conn.logout()
+
+    print(f"Epic 领取回执（最近 {args.hours} 小时，本地时间）")
+    if not rows:
+        print("  （无）")
+        print("合计 0 款")
+        return 0
+    for local, body, _subject in sorted(rows):
+        print(f"  {local} | {body}")
+    print(f"合计 {len(rows)} 笔回执")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
